{
  "experiment_id": "table2text_reference_evaluation_v1",
  "prepared_examples_path": "evaluation/prepared/all_examples.jsonl",
  "generations_path": "evaluation/generations/generations.jsonl",
  "result_directory": "evaluation/results",
  "baseline_variant": "single_agent_baseline",
  "bootstrap_resamples": 5000,
  "confidence_level": 0.95,
  "random_seed": 42,
  "reference_metrics": {
    "enabled_metrics": [
      "bleu",
      "chrf",
      "ter",
      "rouge1",
      "rouge2",
      "rougeL",
      "rougeLsum",
      "meteor",
      "bertscore",
      "parent"
    ],
    "bertscore_model": null,
    "bertscore_batch_size": 8,
    "bertscore_device": null,
    "bertscore_rescale_with_baseline": true,
    "parent_n_jobs": 1,
    "lowercase": false
  },
  "deepeval": {
    "enabled": true,
    "judge_model": "gpt-4.1-mini",
    "judge_repetitions": 3,
    "threshold": 0.5,
    "max_source_characters": 50000,
    "run_summarization": true,
    "run_factual_correctness": true,
    "run_reference_adequacy": true,
    "run_task_relevance": true,
    "run_coherence": true,
    "run_usefulness": true
  }
}
